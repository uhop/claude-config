{
  "printWidth": 100,
  "singleQuote": true,
  "bracketSpacing": false,
  "arrowParens": "avoid",
  "trailingComma": "none",
  "proseWrap": "always",
  "overrides": [
    {
      "files": ["agents/*.md", "skills/writing-style/references/word-list.md"],
      "options": {"proseWrap": "preserve"}
    },
    {
      "files": "settings.json",
      "options": {"printWidth": 1}
    }
  ]
}
